{
  "name": "reins",
  "private": true,
  "version": "0.1.0",
  "description": "REINS \u2014 approval layer for AI agent wallets on Solana (devnet MVP)",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "keygen": "tsx scripts/keygen.ts",
    "setup:check": "tsx scripts/check-setup.ts",
    "sidecar": "pnpm --filter @reins/x402-sidecar dev",
    "merchant": "pnpm --filter @reins/demo-merchant dev",
    "dashboard": "pnpm --filter @reins/dashboard dev",
    "firewall": "cargo run -p reins-firewall",
    "agent": "tsx demo/agent.ts",
    "video:studio": "pnpm --filter @reins/pitch-video studio",
    "video:render": "pnpm --filter @reins/pitch-video render"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@solana/kit": "^8.4.0",
    "@solana/subscriptions": "^0.5.0",
    "dotenv": "^17.0.0"
  },
  "type": "module"
}
